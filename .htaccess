Options -Indexes -MultiViews
# -MultiViews is essentieel: met MultiViews aan (vaak de standaard op
# gedeelde hosting) doet Apache contentonderhandeling op padnamen zonder
# extensie zoals /pagina/mijn-slug, wat de RewriteRule hieronder in de weg
# zit — de nette URL's komen dan op de homepage uit in plaats van de juiste
# pagina.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Expliciete RewriteBase, best practice voor voorspelbaar gedrag.
    RewriteBase /

    # Pretty URL: /pagina/mijn-slug -> pagina.php?slug=mijn-slug
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^pagina/([a-z0-9-]+)/?$ pagina.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^contact/?$ contact.php [L,QSA]

    # SEO/AI-discoverability endpoints, generated dynamically so they always
    # match the domain configured in config/config.php.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^llms\.txt$ llms.php [L]
</IfModule>

<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>
