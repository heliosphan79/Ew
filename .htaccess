Options -Indexes -MultiViews
# -MultiViews is essentieel: met MultiViews aan (vaak de standaard op
# gedeelde hosting) doet Apache contentonderhandeling op padnamen zonder
# extensie zoals /pagina/mijn-slug, wat de RewriteRule hieronder in de weg
# zit — de nette URL's komen dan op de homepage uit in plaats van de juiste
# pagina.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Expliciete RewriteBase, best practice voor voorspelbaar gedrag.
    RewriteBase /

    # Pretty URL: /pagina/mijn-slug -> pagina.php?slug=mijn-slug
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^pagina/([a-z0-9-]+)/?$ pagina.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^contact/?$ contact.php [L,QSA]

    # SEO/AI-discoverability endpoints, generated dynamically so they always
    # match the domain configured in config/config.php.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^llms\.txt$ llms.php [L]
</IfModule>

<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>

# Security headers: safe, low-risk baseline (no CSP — the site loads
# Google Analytics/reCAPTCHA scripts whose exact set of origins can change,
# and a wrong CSP silently breaks those rather than failing loudly).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser caching for static assets — CSS/JS/images are plain files served
# as-is (no cache-busting query string), so a long max-age just means
# re-deploying a changed file needs a hard refresh to see it, same as
# before this existed. PHP pages are deliberately left uncached (admin
# content, contact form, etc. must always be fresh).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
