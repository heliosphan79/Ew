# Blokkeert alle directe HTTP-toegang tot deze map. Bevat het databaseschema
# (schema.sql, migrations/) en een CLI-only seedscript — niets hiervan mag
# via de browser opvraagbaar zijn.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
