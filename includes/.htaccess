# Blokkeert alle directe HTTP-toegang tot deze map. Deze PHP-bestanden zijn
# includes, geen standalone pagina's — ze verwachten o.a. dat bootstrap.php
# al geladen is en mogen nooit rechtstreeks aangeroepen worden.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
